# Copy to .env (never commit .env).
MEMORY_API_KEY=change-me
MEMORY_DATA_DIR=artifacts
# gpt-4o-mini, OpenAI-compatible endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# text-embedding-v4. Native DashScope API (supports query/document types); for an OpenAI-compatible
# endpoint set EMB_STYLE=openai and EMB_BASE_URL=.../compatible-mode/v1
EMB_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMB_STYLE=dashscope
EMB_API_KEY=
EMB_MODEL=text-embedding-v4
# Reranker (qwen3-rerank for text, qwen3-vl-rerank for images); key defaults to EMB_API_KEY
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_API_KEY=
